{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Minishell Test Runner",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod completely to prevent infinite loading hang",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Force GDB to switch focus to the child process on fork",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": false
                },
                {
                    "description": "CRITICAL: Tell GDB to keep both parent and child alive simultaneously",
                    "text": "set detach-on-fork off",
                    "ignoreFailures": false
                },
                {
                    "description": "Prevent GDB from losing track if the child calls an exec function",
                    "text": "set follow-exec-mode new",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Make Test"
        }
    ]
}