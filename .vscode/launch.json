{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Minishell Test Runner",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod completely",
                    "text": "set debuginfod urls ",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod enabled",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Prevent GDB from using a shell to start the process (essential for empty env)",
                    "text": "set startup-with-shell off",
                    "ignoreFailures": false
                },
                {
                    "description": "Clear all inherited environment variables",
                    "text": "unset environment",
                    "ignoreFailures": false
                },
                {
                    "description": "Follow parent on fork",
                    "text": "set follow-fork-mode parent",
                    "ignoreFailures": false
                },
                {
                    "description": "Detach from child process on fork",
                    "text": "set detach-on-fork on",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "Make Test"
        }
    ]
}